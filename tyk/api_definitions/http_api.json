{
  "name": "HTTP API",
  "slug": "http-api",
  "api_id": "http-api-1",
  "org_id": "default",
  "use_keyless": true,
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "proxy": {
    "listen_path": "/http-api/",
    "target_url": "http://http-service:8000/",
    "strip_listen_path": true
  },
  "active": true,
  "disable_rate_limit": true,
  "cache_options": {
    "enable_cache": false,
    "cache_all_safe_requests": false,
    "cache_response_codes": []
  },
  "global_rate_limit": {
    "rate": 0,
    "per": 0
  },
  "extended_paths": {
    "ignored": [],
    "white_list": [],
    "black_list": [],
    "cache": [],
    "transform": [],
    "transform_response": []
  }
}